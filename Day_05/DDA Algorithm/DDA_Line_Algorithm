
import javax.swing.*;
import java.awt.*;

public class DDA_Line_Algorithm extends JFrame{
	
	public DDA_Line_Algorithm(){
		setTitle("DDA Line Drowing Algorithm");
		setSize(600,800);
		setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
		setVisible(true);
	}
	
	@Override
	public void paint(Graphics g){
		
		super.paint(g);
		Graphics2D g2 = (Graphics2D) g;
		
		g2.setColor(Color.BLACK);
		
		drawDDALine(g2,50,50,450,350);
	}
	private void drawDDALine(Graphics2D g2, int x1, int y1, int x2, int y2){
		
		int dx = x2 - x1;
		int dy = y2 - y1;
		
		int steps = Math.max(Math.abs(dx),Math.abs(dy));
		
		float xInc = (float) dx / steps;
		float yInc = (float) dy / steps;
		
		float x = x1;
		float y = y1;
		
		for(int i = 0; i <= steps; i++){
			
			g2.fillRect(Math.round(x),Math.round(y),1,1);
			
			x += xInc;
			y += yInc;
			
			
		}
	}
	
	public static void main(String[] args){
		new DDA_Line_Algorithm();
	}
}
